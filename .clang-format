BasedOnStyle: Google
IndentWidth: 4
---
Language: Cpp

PointerAlignment: Left
BreakAfterReturnType: Automatic
SortIncludes: true

# Fix alignment on class definitions (mostly)
AlignAfterOpenBracket: false
Cpp11BracedListStyle: Block
OneLineFormatOffRegex: "DefineClass|InstanceMethod|StaticMethod|COMPONENT_WRAPPED_METHODS_EXPORT_DEFINE"
